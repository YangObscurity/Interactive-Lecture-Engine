# ═══════════════════════════════════════════════════════════════════════════════
#  .env.example — 本仓库统一配置模板（占位符，**绝不含真实值**）
# ═══════════════════════════════════════════════════════════════════════════════
#
#  用法：
#    1. 在仓库根复制本文件为 `.env`：   cp .env.example .env
#    2. 把下面各项的 `<...>` 占位替换成你的真实值
#    3. 全部脚本经 `scripts/config.py` 自动读取（import 时即载入，无需改调用方式）
#
#  ★ 安全铁律：
#      `.env` 已在根 `.gitignore` 中忽略（`.env` 与 `.env.*`，但放行 `.env.example`），
#      **永远不要**把填好真实值的 `.env` 提交进仓库、贴进 issue / 截图 / 日志。
#
#  优先级（所有脚本一致）：
#      命令行参数  >  真实环境变量  >  `.env` 文件  >  代码内默认值
#      —— 真实环境变量优先于 .env，因此 CI / 容器注入的值不会被本地 .env 覆盖。
#
#  取值自检：
#      python -c "import sys;sys.path.insert(0,'scripts');import config;[print(f'{k:24} {v}') for k,v in config.describe()]"
#      （秘密类字段只显示「已设置（长度 N，已脱敏）」，不会回显令牌正文）
#
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 一、Notion 只读接口
# ─────────────────────────────────────────────────────────────────────────────
# Notion 内部集成令牌（internal integration token），形如 ntn_ 开头。
#   ○ 获取：https://www.notion.so/my-integrations → 新建/查看集成 → 「内部集成密钥」
#   ○ 必做：在目标数据库/页面右上角 ··· → 连接(Connections) → 添加该集成，
#           否则接口会返回 404 object_not_found。
#   ○ 本仓库对 Notion **全程只读**（严禁 create/update/patch/delete 写操作）。
#   ○ ★ 此值一旦在公开渠道泄露过，请立刻到 Notion 后台吊销并重建新令牌。
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion REST API 版本号。协议约定值，一般无需修改。
NOTION_API_VERSION=2022-06-28

# 知识节点数据库 ID（32 位十六进制，带或不带连字符均可）。
NOTION_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 教学法归档目标页面 ID（仅 workspaces/lecture-pedagogy-optimizer 的归档脚本使用）。
NOTION_ARCHIVE_PAGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# 二、部署目标（远程前端机）
# ─────────────────────────────────────────────────────────────────────────────
# 目标主机地址。默认 localhost —— 真实服务器地址请在此注入，勿写回代码。
DEPLOY_HOST=docs.example.com

# SSH 端口。默认 22。
DEPLOY_PORT=22

# SSH 登录用户。
DEPLOY_USER=root

# SSH 私钥**路径**。留空即使用跨平台默认值 ~/.ssh/id_ed25519
# （Windows 展开为 C:\Users\<你>\.ssh\id_ed25519，Linux/macOS 为 ~/.ssh/id_ed25519）。
# 注意：不要在这里写死某个具体用户名，跨平台会失效。
DEPLOY_SSH_KEY=

# SSH 私钥**内容**（PEM 全文，含 BEGIN/END 行）。
# 用途：沙箱 / CI 里挂不了私钥文件时，用环境变量整段注入，
#       脚本会落成 0600 临时文件供 ssh 使用，用完即弃。
# 与 DEPLOY_SSH_KEY 同时存在时，本项优先。
# 多行值可用双引号包裹（.env 解析器保留引号内换行与 #）：
DEPLOY_SSH_KEY_PEM=

# 远端站点根目录（部署产物落地处，通常是 nginx 的 root）。
DEPLOY_WEBROOT=/var/www/example.com

# 本地待部署的 dist 目录（相对于仓库根，或写绝对路径）。
DEPLOY_LOCAL_DIST=site/docs/.vitepress/dist

# 本地源码基线 dist 目录（deploy_inspect.py / deploy_integrity.py 做本地↔线上
# 逐文件比对时使用；留空则回退到 DEPLOY_LOCAL_DIST）。
DEPLOY_SOURCE_DIST=

# 生产站点域名（仅主机名，不带 https:// 与结尾斜杠）。
# 留空时部署脚本会跳过「服务端可达性自测」而不会去连一个不存在的域名。
DEPLOY_SITE_DOMAIN=docs.example.com

# 认证网关域名（Authelia 等登录页），用于可达性自测；不用可留空。
DEPLOY_AUTH_DOMAIN=auth.example.com


# ─────────────────────────────────────────────────────────────────────────────
# 三、远端微服务（讲义检索 / Notion 进度同步 API）
# ─────────────────────────────────────────────────────────────────────────────
# 微服务监听地址与端口。
LECTURE_TOOLS_HOST=127.0.0.1
LECTURE_TOOLS_PORT=8099

# 远端 nginx 站点配置目录（deploy_backend_notion_sync.py 注入 location 时使用）。
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available


# ─────────────────────────────────────────────────────────────────────────────
# 四、源码镜像同步（仓库根 sync.py）
# ─────────────────────────────────────────────────────────────────────────────
# 真实工作副本目录（VitePress 站点源码，在那里编辑与构建）。
#   留空 -> sync.py 退化为「以本仓库 site/ 为工作副本」的沙箱模式（两边一致，不做镜像）。
#   本地外部内容源目录路径，未配置时默认使用仓库内 site/docs 作为工作目录。
LECTURE_SITE=

# 上游知识库工作副本根目录。未配置时无默认值。
PROJECT_MEMORY=


# ─────────────────────────────────────────────────────────────────────────────
# 五、测试
# ─────────────────────────────────────────────────────────────────────────────
# 端到端测试打的生产站点根 URL（含 https://，不带结尾斜杠）。
# 留空则测试脚本会明确提示缺配置，而不是去请求一个硬编码域名。
TEST_BASE_URL=https://docs.example.com

# 端到端测试用的 Notion 页面 ID。属个人数据，**无默认值**（历史上硬编码过真实 page id）。
TEST_PAGE_ID=

# 进度同步 API 的完整端点（test_date_lifecycle.py 本地直连版用）。
# 留空则脚本明确报错；历史上这里硬编码过真实生产域名。
TEST_SYNC_API_URL=https://docs.example.com/api/progress/notion-sync


# ─────────────────────────────────────────────────────────────────────────────
# 六、其它路径（多为原硬编码绝对路径的替代）
# ─────────────────────────────────────────────────────────────────────────────
# 本地知识图谱 JSON 路径（upload_graph_to_server.py 上传源）。
# 留空则回退到仓库内标准位置 site/docs/public/notion_knowledge_graph.json。
GRAPH_LOCAL_PATH=

# 远端微服务源码落地路径（deploy_backend_notion_sync.py 上传目标）。
REMOTE_SERVER_PY=/opt/lecture-tools/server.py

