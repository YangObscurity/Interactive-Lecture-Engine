# ═══════════════════════════════════════════════════════════════════════════════
#  .env.example — 本仓库统一配置模板（占位符，绝不含真实凭据）
# ═══════════════════════════════════════════════════════════════════════════════
#
#  用法：
#    1. 在仓库根复制本文件为 `.env`：   cp .env.example .env
#    2. 把需要项的占位替换成你的真实值
#    3. 运行交互向导或体检工具（在 site/ 目录下）：
#       npm run setup   # 交互式向导，按模块配置并校验
#       npm run doctor  # 检查当前配置状态与可达性
#
#  ★ 安全铁律：
#      `.env` 已在根 `.gitignore` 中忽略（`.env` 与 `.env.*`，放行 `.env.example`），
#      永远不要把填好真实值的 `.env` 提交进仓库、贴进 issue / 截图 / 日志。
#
#  优先级（所有脚本与工具一致）：
#      真实环境变量（非空） > 仓库根 `.env` > 兼容旧文件 (DEPLOY_ENV_FILE / scripts/deploy.local.env) > 代码内默认值
#      对于带有别名 (alias) 的配置项，在每一级先尝试标准键名，再尝试别名，然后才进入下一级。
#
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 站点模块（progress / companion / graph / contentSync / auth）
# ─────────────────────────────────────────────────────────────────────────────
# 站点模块属于构建期前端配置，不在此文件设置，请在 site/lecture.config.ts 的 modules 块配置。
# 例如：
#   modules: {
#     progress: { adapter: 'local' },
#     companion: { adapter: 'off' },
#     graph: { source: 'merge' },
#     contentSync: { adapter: 'none' },
#     auth: { adapter: 'none' },
#   }
# 这里的 .env 仅用于服务连接凭据、远端部署及脚本工具配置。


# ─────────────────────────────────────────────────────────────────────────────
# Notion 只读接口 — 本仓库对 Notion 全程只读
# ─────────────────────────────────────────────────────────────────────────────

# Notion 内部集成令牌（ntn_ 开头）。在 notion.so/my-integrations 创建，并在目标数据库「连接」里添加该集成，否则接口返回 404。本仓库对 Notion 只读；令牌泄露过就立刻吊销重建
# [秘密] [模块启用时必填] contentSync = notion 时需要
NOTION_TOKEN=

# Notion REST API 版本号，协议约定值，一般不用改
NOTION_API_VERSION=2022-06-28

# 知识节点数据库 ID（32 位十六进制，带不带连字符均可），私有工作区标识
# [秘密] [模块启用时必填] contentSync = notion 时需要
NOTION_DB_ID=

# 教学法归档目标页面 ID，只有归档脚本使用
# [秘密]
NOTION_ARCHIVE_PAGE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 部署目标 — 远程前端机的 SSH 与站点目录
# ─────────────────────────────────────────────────────────────────────────────

# 目标主机地址。真实地址只写在 .env 或环境变量里，不要写回代码
# [模块启用时必填]
DEPLOY_HOST=localhost

# SSH 端口
DEPLOY_PORT=22

# SSH 登录用户
DEPLOY_USER=root

# SSH 私钥路径。留空用跨平台默认 ~/.ssh/id_ed25519；不要写死某个用户名
# 旧名 DEPLOY_KEY 仍可读取
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# SSH 私钥内容（PEM 全文）。CI 或沙箱挂不了文件时整段注入，与 DEPLOY_SSH_KEY 同时存在时优先；多行值用双引号包裹
# [秘密]
DEPLOY_SSH_KEY_PEM=

# 远端站点根目录（部署产物落地处，通常是 nginx 的 root）
# [模块启用时必填]
DEPLOY_WEBROOT=/var/www/example.com

# 本地待部署的 dist 目录（相对仓库根或绝对路径）
DEPLOY_LOCAL_DIST=site/docs/.vitepress/dist

# 本地↔线上逐文件比对用的基线 dist 目录；留空回退到 DEPLOY_LOCAL_DIST
DEPLOY_SOURCE_DIST=

# 生产站点域名（只写主机名，不带 https:// 与结尾斜杠）。留空时跳过服务端可达性自测
# 旧名 DEPLOY_DOMAIN 仍可读取
DEPLOY_SITE_DOMAIN=example.com

# 认证网关域名（Authelia 等登录页），用于可达性自测；不用可留空
DEPLOY_AUTH_DOMAIN=auth.example.com

# 公开站点的完整地址，如 https://lectures.example.org；设置后生成 sitemap.xml 与 hreflang 互指。私有站留空
SITE_URL=

# 部署目标的显示名，只用于日志，不参与连接
DEPLOY_HOST_LABEL=

# 旧版部署配置文件位置（默认 scripts/deploy.local.env，仍兼容读取）；新配置请写 .env
DEPLOY_ENV_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# 远端微服务 — 讲义检索与 Notion 进度同步 API
# ─────────────────────────────────────────────────────────────────────────────

# 微服务监听地址
LECTURE_TOOLS_HOST=127.0.0.1

# 微服务监听端口
LECTURE_TOOLS_PORT=8099

# 远端 nginx 站点配置目录（部署微服务时注入 location 用）
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available

# 远端微服务源码落地路径
REMOTE_SERVER_PY=/opt/lecture-tools/server.py

# ─────────────────────────────────────────────────────────────────────────────
# 源码镜像同步 — 仓库根 sync.py 使用的工作副本位置
# ─────────────────────────────────────────────────────────────────────────────

# 真实工作副本目录（VitePress 站点源码）。留空则 sync.py 以本仓库 site/ 为工作副本
LECTURE_SITE=

# 上游知识库工作副本根目录，没有默认值
PROJECT_MEMORY=

# ─────────────────────────────────────────────────────────────────────────────
# 测试 — 端到端测试的目标地址与数据
# ─────────────────────────────────────────────────────────────────────────────

# 端到端测试打的站点根 URL（含 https://，不带结尾斜杠）；留空时测试明确报缺配置
# [模块启用时必填]
TEST_BASE_URL=https://example.com

# 端到端测试用的 Notion 页面 ID，属个人数据，没有默认值
# [秘密]
TEST_PAGE_ID=

# 进度同步 API 完整端点（本地直连测试用）；留空则脚本明确报错
TEST_SYNC_API_URL=https://example.com/api/progress/notion-sync

# ─────────────────────────────────────────────────────────────────────────────
# 其它路径 — 原先硬编码绝对路径的替代
# ─────────────────────────────────────────────────────────────────────────────

# 本地知识图谱 JSON 路径；留空回退到 site/docs/public/notion_knowledge_graph.json
GRAPH_LOCAL_PATH=

# AI 伴读提示词与快捷动作 JSON 路径；留空回退到 site/prompts/companion.json
AI_PROMPTS_FILE=prompts/companion.json

# ─────────────────────────────────────────────────────────────────────────────
# 配置本身 — 本机启用了哪些工具模块
# ─────────────────────────────────────────────────────────────────────────────

# 本机使用的工具模块（逗号分隔，由 npm run setup 写入）；留空时 doctor 按已设置的键推断
LECTURE_MODULES=notion,deploy
