{
  "name": "lecture-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "G01 讲义可交互阅读站点",
  "scripts": {
    "predev": "npm run content:sync -- --drafts",
    "dev": "vitepress dev docs",
    "prebuild": "npm run content:sync",
    "build": "node scripts/build.mjs",
    "preview": "vitepress preview docs",
    "content:sync": "node scripts/content/sync.mts",
    "content:watch": "node scripts/content/watch.mts",
    "content:migrate": "node scripts/content/migrate.mts",
    "init": "node scripts/content/init.mts",
    "new:group": "node scripts/content/new-group.mts",
    "new:lecture": "node scripts/content/new-lecture.mts",
    "check:content": "node scripts/content/check.mts",
    "check:lectures": "python ../scripts/check_lecture_contracts.py",
    "check:lectures:spi": "python ../scripts/check_lecture_contracts.py --group spi",
    "check:links": "python ../scripts/check_body_links.py",
    "verify:spi": "npm run check:lectures:spi && npm run build && npm run check:links",
    "config:gen": "node scripts/config/gen.mts",
    "config:check": "node scripts/config/gen.mts --check",
    "setup": "node scripts/config/setup.mts",
    "doctor": "node scripts/config/doctor.mts",
    "pregen": "node scripts/pregenerate_assets.mjs",
    "pregen:all": "node scripts/pregenerate_assets.mjs --all",
    "pregen:setup": "node scripts/manage_export_dep.mjs --install",
    "pregen:remove": "node scripts/manage_export_dep.mjs --uninstall",
    "pregen:clean": "node scripts/manage_export_dep.mjs --clean-assets",
    "pregen:status": "node scripts/manage_export_dep.mjs --status",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:legacy": "node scripts/ts_baseline.mjs",
    "lint": "eslint . && node scripts/check_theme_contract.mjs && node scripts/check_i18n_strings.mjs",
    "check:theme": "node scripts/check_theme_contract.mjs",
    "check:i18n": "node scripts/check_i18n_strings.mjs",
    "check:i18n:dist": "node scripts/check_i18n_dist.mjs",
    "check:access:dist": "node scripts/check_access_dist.mjs",
    "check:search:dist": "node scripts/check_search_dist.mjs",
    "check:figures": "node scripts/figures/check_figures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:e2e:access": "node scripts/build_access_e2e.mjs",
    "test:e2e:access": "node scripts/build_access_e2e.mjs && playwright test --project access",
    "test:e2e:update": "playwright test --update-snapshots",
    "auth:export": "node scripts/auth_export.mjs",
    "check": "npm run typecheck && npm run typecheck:legacy && npm run lint && npm run check:figures && npm run check:content && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.6.0",
    "elkjs": "0.9.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^20.14.6",
    "jiti": "2.7.0",
    "libavoid-js": "0.5.0-beta.5",
    "markdown-it": "^15.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "unist-util-visit": "5.2.0",
    "vitepress": "1.6.4",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "echarts": "^5.6.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.47",
    "marked": "16.4.2",
    "mermaid": "^11.4.1",
    "minisearch": "^7.2.0",
    "photoswipe": "5.4.4",
    "shiki": "2.5.0",
    "wavedrom": "^3.7.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
