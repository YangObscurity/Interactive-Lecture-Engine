{
  "$description": "minimal-slot: example third-party theme pack. It overrides only the SidebarStatus slot and inherits every shared token from the reader theme; colours are copied from reader light/dark. Used by tests and docs-dev/SLOTS.md, not enabled on this site.",
  "$extensions": {
    "org.lecture-engine": {
      "id": "minimal-slot",
      "label": "Minimal slot example",
      "contract": 1,
      "engine": "^1",
      "components": {
        "SidebarStatus": "./components/SidebarStatus.vue"
      }
    }
