{
  "$description": "datasheet: device-datasheet (light) / PCB (dark) preset used by this site. Values mirror the spec board THEMES.datasheet.",
  "$extensions": {
    "org.lecture-engine": {
      "id": "datasheet",
      "label": "器件手册",
      "contract": 1,
      "skin": "pinout",
      "engine": "^1",
      "components": {
        "SidebarStatus": "./components/SidebarStatus.vue",
        "AtlasCenter": "./components/AtlasCenter.vue",
        "AtlasCategory": "./components/AtlasCategory.vue",
        "AtlasGroup": "./components/AtlasGroup.vue",
        "AtlasPhase": "./components/AtlasPhase.vue",
        "AtlasLecture": "./components/AtlasLecture.vue",
        "AtlasLink": "./components/AtlasLink.vue",
        "GroupCard": "./components/GroupCard.vue",
        "GroupMap": "./components/GroupMap.vue",
        "CanvasGroup": "./components/CanvasGroup.vue",
        "CanvasNode": "./components/CanvasNode.vue",
        "CanvasEdge": "./components/CanvasEdge.vue",
        "CanvasBackdrop": "./components/CanvasBackdrop.vue",
        "LectureTitleBlock": "./components/LectureTitleBlock.vue",
        "FigureFrame": "./components/FigureFrame.vue",
        "QuizHeader": "./components/QuizHeader.vue",
        "SearchPanel": "./components/SearchPanel.vue",
        "NavCourseMenu": "./components/NavCourseMenu.vue"
      },
      "layout": {
        "edges": "orthogonal"
      },
      "fonts": [
        "@fontsource-variable/noto-serif-sc/wght.css",
        "@fontsource-variable/noto-sans-sc/wght.css",
        "@fontsource/jetbrains-mono/400.css"
      ]
    }
  },
  "shared": {
    "font-body": {
      "$type": "fontFamily",
      "$value": [
        "Noto Serif SC Variable",
        "Noto Serif SC",
        "Songti SC",
        "SimSun",
        "serif"
      ]
    },
    "font-heading": {
      "$type": "fontFamily",
      "$value": [
        "Noto Sans SC Variable",
        "Noto Sans SC",
        "PingFang SC",
        "Microsoft YaHei",
        "sans-serif"
      ]
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "Cascadia Mono",
        "Consolas",
        "monospace"
      ]
    },
    "font-body-serif": {
      "$type": "fontFamily",
      "$value": [
        "Noto Serif SC Variable",
        "Noto Serif SC",
        "Songti SC",
        "SimSun",
        "serif"
