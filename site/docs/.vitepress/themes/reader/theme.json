{
  "$description": "reader: default open-source theme. Reader-style, system font stacks (zero webfont downloads), restrained accent. Values mirror the spec board THEMES.reader.",
  "$extensions": {
    "org.lecture-engine": {
      "id": "reader",
      "label": "阅读",
      "contract": 1,
      "skin": "tiles",
      "fonts": []
    }
  },
  "shared": {
    "font-body": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "sans-serif"
      ]
    },
    "font-heading": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "sans-serif"
      ]
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SF Mono",
        "Cascadia Mono",
        "Consolas",
        "monospace"
      ]
    },
    "font-body-serif": {
      "$type": "fontFamily",
      "$value": [
        "Songti SC",
        "SimSun",
        "Noto Serif CJK SC",
        "serif"
      ]
    },
    "font-body-sans": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "sans-serif"
      ]
    },
    "radius-1": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "radius-2": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "status-radius": {
      "$type": "dimension",
      "$value": {
        "value": 50,
        "unit": "%"
      },
      "$description": "Round status marks. DTCG 2025.10 dimensions only define px/rem; the engine accepts % for this token only."
    },
    "heading-weight": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
