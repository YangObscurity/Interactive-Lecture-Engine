# ═══════════════════════════════════════════════════════════════════════════════
#  server/.env.example — lecture-api 后端配置模板（由 src/config/schema.ts 生成）
# ═══════════════════════════════════════════════════════════════════════════════
#
#  用法：
#    1. 复制本文件为 server/.env：   cp .env.example .env
#    2. 或在 server/ 目录运行配置向导：npm run setup
#    3. 本文件由 npm run config:gen 生成，可用 npm run config:check 校验一致性
#
#  优先级：process.env 环境变量 > server/.env > 网关预设 / 默认值
#  安全红线：server/.env 已被 .gitignore 忽略，严禁将含真实凭据的 .env 提交到仓库。
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 数据库配置（Database） — PostgreSQL / Neon 连接串或本地 PGlite 存储配置
# ─────────────────────────────────────────────────────────────────────────────

# 数据库连接串（运行时使用；支持 postgres:// / postgresql:// / pglite:memory / pglite:<目录>）
# [秘密] [必填]
# 示例: postgresql://user:password@ep-pooler.ap-southeast-1.aws.neon.tech/lecture?sslmode=require
DATABASE_URL=

# 数据库直连地址（可选，用于迁移；Neon 建议填非池化地址，未设置时回落到 DATABASE_URL）
# [秘密] [可选]
# 示例: postgresql://user:password@ep-direct.ap-southeast-1.aws.neon.tech/lecture?sslmode=require
DATABASE_URL_DIRECT=

# ─────────────────────────────────────────────────────────────────────────────
# 网络与监听配置（Server） — HTTP 服务绑定主机地址与监听端口
# ─────────────────────────────────────────────────────────────────────────────

# HTTP 服务监听地址（启用 trusted-header 时须为回环地址，除非显式开启 ALLOW_NON_LOOPBACK）
# [可选] 默认: 127.0.0.1
HOST=127.0.0.1

# HTTP 服务监听端口（1–65535）
# [可选] 默认: 8100
PORT=8100

# ─────────────────────────────────────────────────────────────────────────────
# 身份与权限配置（Auth） — 认证适配器、网关请求头预设、组分隔符与角色映射
# ─────────────────────────────────────────────────────────────────────────────

# 身份认证适配器（none：全部请求视为 anonymous；trusted-header：从前置认证网关头读取）
# [可选] 可选值: none | trusted-header 默认: none
AUTH_ADAPTER=none

# 认证网关请求头预设（authelia / authentik / oauth2-proxy / custom）
# [可选] 可选值: authelia | authentik | oauth2-proxy | custom 默认: authelia
AUTH_HEADER_PRESET=authelia

# 用户 ID 请求头名（可覆盖预设；AUTH_HEADER_PRESET=custom 且启用 trusted-header 时必填）
# [可选]
# 示例: Remote-User
AUTH_HEADER_USER=

# 用户组请求头名（可选，覆盖预设默认值）
# [可选]
# 示例: Remote-Groups
AUTH_HEADER_GROUPS=

# 用户邮箱请求头名（可选，覆盖预设默认值）
# [可选]
# 示例: Remote-Email
AUTH_HEADER_EMAIL=

# 用户显示名请求头名（可选，覆盖预设默认值）
# [可选]
# 示例: Remote-Name
AUTH_HEADER_NAME=

# 用户组请求头分隔符（可选，覆盖预设默认值；authelia/oauth2-proxy/custom 默认为 ","，authentik 默认为 "|"）
# [可选]
# 示例: ,
AUTH_GROUP_SEPARATOR=

# 网关用户组到系统角色的映射（逗号分隔 <组名>:<reader|author|admin>，reader 角色始终自动保留）
# [可选]
# 示例: admins:admin,authors:author
AUTH_ROLE_MAP=

# 认证网关登出跳转地址（可选，http:// 或 https://）
# [可选]
# 示例: https://auth.example.com/logout
LOGOUT_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 大模型伴读与代理配置（AI Companion & Proxy） — AI 提供商选择、API 根路径、API Key、超时、上传尺寸、每用户限流与输入上限
# ─────────────────────────────────────────────────────────────────────────────

# AI 伴读服务提供商（off：关闭伴读代理；dify：Dify 服务；openai：OpenAI 兼容服务）
# [可选] 可选值: off | dify | openai 默认: off
AI_PROVIDER=off

# Dify 服务 API 根路径
# [可选] 默认: https://api.dify.ai/v1
DIFY_API_BASE=https://api.dify.ai/v1

# Dify 应用 API Key（AI_PROVIDER=dify 时必填）
# [秘密] [可选]
# 示例: app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_API_KEY=

# OpenAI 兼容服务 /v1 根路径
# [可选] 默认: https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI API Key（AI_PROVIDER=openai 时必填）
# [秘密] [可选]
# 示例: sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# OpenAI 模型 ID
# [可选] 默认: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# AI 上游连接与首包超时毫秒数（1000–300000）
# [可选] 默认: 60000
AI_UPSTREAM_TIMEOUT_MS=60000

# 课件上传允许的最大字节数（1024–104857600，默认 20MB）
# [可选] 默认: 20971520
AI_UPLOAD_MAX_BYTES=20971520

# AUTH_ADAPTER=none 时是否仍开放 /api/ai/*（默认 false：none 模式下 AI 路由返回 403，避免所有访客共用匿名身份消耗上游额度）
# [可选] 默认: false
AI_ALLOW_ANONYMOUS=false

# 每用户每分钟允许的 /api/ai/* 请求数（令牌桶，进程内计数；1–600）
# [可选] 默认: 20
AI_RATE_PER_MINUTE=20

# 每用户同时进行的 /api/ai/chat 流式会话上限（1–20）；上传另有每用户 1 个并发的固定上限
# [可选] 默认: 2
AI_MAX_CONCURRENT=2

# 每个读者每个 UTC 自然日允许的 /api/ai/* 请求数（1–100000）；作者与管理员（AUTH_ROLE_MAP）不计
# [可选] 默认: 300
AI_DAILY_LIMIT=300

# /api/ai/chat 中 query 的最大字节数（UTF-8，256–65536），超限返回 413
# [可选] 默认: 8192
AI_QUERY_MAX_BYTES=8192

# /api/ai/chat 中 inputs 各字段值合计的最大字节数（UTF-8，1024–131072），超限返回 413
# [可选] 默认: 32768
AI_INPUTS_MAX_BYTES=32768

# 单次 /api/ai/chat 流式响应的总时长上限毫秒数（10000–1800000）；超时以 event: error 帧结束流
# [可选] 默认: 300000
AI_STREAM_MAX_MS=300000

# 是否对每次 /api/ai/* 调用输出一行结构化访问日志（哈希用户 ID、路由、字节数、状态、耗时、限流命中；从不记录提示词、回答与密钥）
# [可选] 默认: true
AI_ACCESS_LOG=true

# AI 伴读系统提示词与快捷动作 JSON 文件路径；留空时依次尝试 ./prompts/companion.json、../site/prompts/companion.json 与站点构建产物
# [可选]
# 示例: prompts/companion.json
AI_PROMPTS_FILE=

# 站点构建产物目录路径（用于加载 tools/tiers.json、concepts.json、lectures.json）；留空时默认使用 ../site/docs/.vitepress/dist
# [可选]
# 示例: ../site/docs/.vitepress/dist
SITE_DIST_DIR=

# AI 工具与外部 MCP 服务器配置文件路径（ai-tools.json）；留空时优先通过站点 content 路径模块解析
# [可选]
# 示例: ../site/ai-tools.json
AI_TOOLS_FILE=

# 单次 AI 工具调用（含外部 MCP 工具）超时毫秒数（100–120000）
# [可选] 默认: 8000
AI_TOOL_TIMEOUT_MS=8000

# 单次 AI 工具返回结果的最大 UTF-8 字节数（256–1048576）
# [可选] 默认: 24000
AI_TOOL_MAX_RESULT_BYTES=24000

# AI_PROVIDER=openai 原生对话每轮允许的最大工具调用步数（1–20）
# [可选] 默认: 5
AI_TOOL_MAX_STEPS=5

# Dify 访问 /api/mcp 端点所需的 Bearer 鉴权令牌；留空时 /api/mcp 端点禁用
# [秘密] [可选]
# 示例: replace-with-random-mcp-bearer-token
AI_MCP_TOKEN=

# 签发与校验 Dify tool_ticket 短期访问档票据的 HMAC-SHA256 密钥；未配置或校验失败时按 public 档处理（全站需登录的站点没有 public 档，此时什么也读不到）
# [秘密] [可选]
# 示例: replace-with-random-hmac-ticket-secret
AI_MCP_TICKET_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 运维与安全配置（Ops & Security） — 自动迁移门禁、健康检查探测、非回环安全护栏、写请求限流与日志级别
# ─────────────────────────────────────────────────────────────────────────────

# 服务启动时发现未执行迁移是否自动执行（默认 false；为 false 时如有待迁移表结构将拒绝启动）
# [可选] 默认: false
DB_AUTO_MIGRATE=false

# Notion 同步伴随服务的健康检查探测地址（可选，留空时 /api/health 返回 checks.notion = "off"）
# [可选]
# 示例: http://127.0.0.1:8099/health
NOTION_HEALTH_URL=

# 是否允许在 AUTH_ADAPTER=trusted-header 下绑定非回环 HOST（仅在确认上游反代已覆盖身份头时设为 true）
# [可选] 默认: false
ALLOW_NON_LOOPBACK=false

# 服务日志输出级别（debug / info / warn / error）
# [可选] 可选值: debug | info | warn | error 默认: info
LOG_LEVEL=info

# 每用户每分钟允许的写请求数（/api/db/* 与 /api/progress/* 的 POST/PATCH/PUT/DELETE；令牌桶，进程内计数；1–6000）
# [可选] 默认: 120
WRITE_RATE_PER_MINUTE=120
