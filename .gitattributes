# Generated data must stay byte-identical to the importer output on every machine.
site/data/*.json text eol=lf
design/prototypes/** text eol=lf

# P2c: generated config files are compared byte for byte by npm run config:check
.env.example text eol=lf
site/config/schema.json text eol=lf

# Figures are checked against the sha256 in their registry: keep their bytes identical on every machine (no EOL conversion).
site/docs/public/figures/** -text
templates/demo-content/figures/** -text
